# =============================================================================
# Research Assistant System — Environment Configuration
# =============================================================================

# OpenAI API Key (required for real LLM calls and embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Default research topic (used if --topic flag is not provided)
RESEARCH_TOPIC=Impact of AI agents on software development

# Mock mode settings
# Set to "true" to use mock LLM responses (no API key needed)
USE_MOCK_LLM=true
# Set to "true" to use mock embeddings (no API key needed)
USE_MOCK_EMBEDDINGS=true

# LLM model to use (when USE_MOCK_LLM=false)
OPENAI_MODEL=gpt-4o-mini

# Embedding model to use (when USE_MOCK_EMBEDDINGS=false)
EMBEDDING_MODEL=text-embedding-3-small

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum critic retry loops before forcing writer
MAX_CRITIC_RETRIES=2

# Session ID prefix
SESSION_PREFIX=research
